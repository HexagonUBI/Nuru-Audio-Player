export component NuruMark {
    in property <length> size: 20px;
    in property <bool> pulse: false;
    in property <bool> tinted: false;
    in property <color> tint;
    width: root.size;
    height: root.size;

    private property <float> wave-1: root.pulse ? 0.5 - 0.5 * Math.cos(Math.mod(animation-tick() / 3.4s, 1.0) * 360deg) : 0;
    private property <float> wave-2: root.pulse ? 0.5 - 0.5 * Math.cos(Math.mod((animation-tick() - 0.35s) / 3.4s, 1.0) * 360deg) : 0;

    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M1.6 15.5a10.4 10.4 0 0 1 20.8 0";
        stroke: root.tinted ? root.tint : #ffc468;
        stroke-width: 1.7 * root.size / 24;
        stroke-line-cap: round;
        fill: transparent;
        opacity: root.pulse ? 0.28 + 0.52 * root.wave-2 : 0.34;
    }

    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M5.6 15.5a6.4 6.4 0 0 1 12.8 0";
        stroke: root.tinted ? root.tint : #ff8e6c;
        stroke-width: 1.9 * root.size / 24;
        stroke-line-cap: round;
        fill: transparent;
        opacity: root.pulse ? 0.28 + 0.52 * root.wave-1 : 0.72;
    }

    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M8.6 15.5a3.4 3.4 0 1 0 6.8 0a3.4 3.4 0 1 0 -6.8 0Z";
        fill: root.tinted ? root.tint.mix(#ffffff, 0.38) : #ffffd4;
    }
}
