import { Theme } from "theme.slint";
import { Effects, Shadow } from "effects.slint";
import { TileData } from "types.slint";

export component Tile inherits TouchArea {
    in property <TileData> data;
    in property <length> size: 216px;
    in property <length> radius: 16px;
    in property <length> label-size: 22px;
    width: root.size;
    height: root.size;
    mouse-cursor: pointer;

    private property <bool> lifted: root.has-hover && !root.pressed;
    private property <bool> on: root.data.active;

    body := Rectangle {
        width: parent.width;
        height: parent.height;
        y: root.lifted ? -4px : root.pressed ? -1px : 0px;
        animate y { duration: Theme.dur-3; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

        Shadow {
            source: Effects.tile-rest;
            pad: Effects.tile-rest-pad;
            dy: 8px;
            box-width: parent.width;
            box-height: parent.height;
            colorize: #00000047;
            opacity: root.lifted ? 0 : 1;
            animate opacity { duration: Theme.dur-3; easing: ease-out; }
        }

        Shadow {
            source: Effects.tile-lifted;
            pad: Effects.tile-lifted-pad;
            dy: 20px;
            box-width: parent.width;
            box-height: parent.height;
            colorize: #00000066;
            opacity: root.lifted ? 1 : 0;
            animate opacity { duration: Theme.dur-3; easing: ease-out; }
        }

        Shadow {
            source: Effects.tile-tight;
            pad: Effects.tile-tight-pad;
            dy: root.lifted ? 4px : 2px;
            box-width: parent.width;
            box-height: parent.height;
            colorize: #0000004d;
        }

        Shadow {
            source: Effects.tile-glow;
            pad: Effects.tile-glow-pad;
            spread: -6px;
            dy: 4px;
            box-width: parent.width;
            box-height: parent.height;
            colorize: root.data.accent;
            opacity: root.on ? 1 : 0;
            animate opacity { duration: Theme.dur-3; easing: ease-out; }
        }

        Image {
            visible: root.data.cover.width == 0;
            width: parent.width;
            height: parent.height;
            source: Effects.tile-mask;
            colorize: Theme.s-600;
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: root.on ? root.data.active-cover : root.data.cover;
        }

        Image {
            visible: !root.on;
            width: parent.width;
            height: parent.height;
            source: Effects.tile-mask;
            colorize: #07080a;
            opacity: root.lifted ? 0.565 : 0.66;
            animate opacity { duration: Theme.dur-3; easing: ease-out; }
        }

        Text {
            x: 16px;
            y: label.y + 1px;
            width: label.width;
            text: root.data.name;
            font-family: Theme.display-font;
            font-size: root.label-size;
            font-weight: 600;
            letter-spacing: -0.01 * root.label-size;
            wrap: word-wrap;
            color: root.on ? #ffffff40 : #000000a6;
            stroke: root.on ? #ffffff1f : #00000038;
            stroke-width: root.on ? 4px : 3px;
            stroke-style: outside;
        }

        label := Text {
            x: 16px;
            y: parent.height - self.height - 14px;
            width: parent.width - 32px;
            text: root.data.name;
            font-family: Theme.display-font;
            font-size: root.label-size;
            font-weight: 600;
            letter-spacing: -0.01 * root.label-size;
            wrap: word-wrap;
            color: root.on ? #0a0b0de6 : Theme.ink;
        }

        if root.data.loading: Rectangle {
            x: parent.width - 26px;
            y: 12px;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: 2px;
            border-color: #ffffff40;

            property <angle> turn: Math.mod(animation-tick() / 0.7s, 1.0) * 360deg;

            Path {
                width: 14px;
                height: 14px;
                viewbox-width: 14;
                viewbox-height: 14;
                commands: "M " + (7 + 6 * Math.cos(parent.turn)) + " " + (7 + 6 * Math.sin(parent.turn)) + " A 6 6 0 0 1 " + (7 + 6 * Math.cos(parent.turn + 90deg)) + " " + (7 + 6 * Math.sin(parent.turn + 90deg));
                stroke: #ffffff;
                stroke-width: 2px;
                stroke-line-cap: round;
                fill: transparent;
            }
        }
    }
}
