import "fonts/Comfortaa-Variable.ttf";

export global Theme {
    in-out property <string> name: "midnight";

    out property <color> s-900: root.name == "ember" ? #0a0807 : root.name == "slate" ? #0c0d11 : #0b0c0e;
    out property <color> s-800: root.name == "ember" ? #141110 : root.name == "slate" ? #15161c : #131417;
    out property <color> s-700: root.name == "ember" ? #1c1817 : root.name == "slate" ? #1c1e25 : #1a1c20;
    out property <color> s-600: root.name == "ember" ? #251f1d : root.name == "slate" ? #24262f : #22242a;
    out property <color> s-500: root.name == "ember" ? #302926 : root.name == "slate" ? #2e313b : #2c2f36;
    out property <color> s-400: root.name == "ember" ? #40372f : root.name == "slate" ? #3c404c : #3a3e47;

    out property <color> line-soft: #ffffff0d;
    out property <color> line: #ffffff14;
    out property <color> line-strong: #ffffff24;

    out property <color> ink: #f3f4f6;
    out property <color> ink-80: #f3f4f6cc;
    out property <color> ink-60: #f3f4f699;
    out property <color> ink-40: #f3f4f666;
    out property <color> ink-25: #f3f4f640;
    out property <color> ink-12: #f3f4f61f;
    out property <color> ink-inverse: #131417;

    out property <color> nuru: root.name == "ember" ? #ff9d4d : root.name == "slate" ? #7dd3fc : #ffb454;
    out property <color> nuru-bright: root.name == "ember" ? #ffb877 : root.name == "slate" ? #a5e3ff : #ffc978;
    out property <color> nuru-ghost: root.name == "slate" ? #7dd3fc1f : #ffb4541f;

    out property <color> danger: #ff5f57;
    out property <color> danger-dim: #ff5f5729;

    out property <color> hover: #ffffff12;
    out property <color> field: #ffffff0d;

    out property <string> display-font: "Comfortaa";
    out property <string> ui-font: "Segoe UI";

    out property <length> titlebar-h: 38px;
    out property <length> mixer-w: 300px;

    out property <duration> dur-1: 90ms;
    out property <duration> dur-2: 160ms;
    out property <duration> dur-3: 260ms;
    out property <duration> dur-4: 420ms;
}

