import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <length> size: 16px;
    in property <float> weight: 1.7;
    in property <bool> filled: false;
    in property <brush> tint: Theme.ink-40;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.filled ? root.tint : transparent;
    stroke: root.filled ? transparent : root.tint;
    stroke-width: root.weight * root.size / 24;
    stroke-line-cap: round;
}
