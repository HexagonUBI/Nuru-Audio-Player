{
  "name": "nuru",
  "productName": "Nuru",
  "version": "0.0.1",
  "description": "Play any combination of ambient sounds, seamlessly looped.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "db:dev": "node server/index.js",
    "db:seed": "node server/seed.mjs",
    "db:tags": "node server/tags.mjs",
    "db:promote": "node server/promote.mjs",
    "db:reset": "node server/reset.mjs && npm run db:seed",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "app:dev": "npm run version:sync && tauri dev",
    "app:build": "npm run version:sync && tauri build",
    "version:sync": "node scripts/sync-version.mjs",
    "pack:placeholder": "node scripts/build-placeholder-pack.mjs",
    "db:pack": "node scripts/pack-workshop.mjs",
    "icons": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.1",
    "@tauri-apps/plugin-fs": "^2.2.1",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@tauri-apps/plugin-store": "^2.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.5.0",
    "rcedit": "^5.0.2",
    "svelte": "^5.28.2",
    "svelte-check": "^4.1.6",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
